# CorpIntel AI - Environment Variables Template
# Copy this file to .env locally or set these environment variables in your Vercel Project Settings.

# Google Gemini API Key (Required for AI Reasoning Engine)
GOOGLE_API_KEY=AIzaSy...

# Serper.dev Search API Key (Required for Live Web & Company Knowledge Graph Search)
SERPER_API_KEY=...

# Optional OpenRouter API Key (Fallback AI Engine)
OPENROUTER_API_KEY=

# Default Model Selection
DEFAULT_MODEL=google/gemini-2.5-flash
